SECRET_PASSWORD=
POSTGRES_PASSWORD=
SUPPORT_EMAIL=support@example.com
RALLLY_PORT=3200

# Authentik (IdP OIDC)
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
# Le provider OIDC et l'application "rallly" sont créés au démarrage par le
# blueprint authentik/blueprints/rallly.yaml, avec ces identifiants.
OIDC_DISCOVERY_URL=http://authentik.localhost:9000/application/o/rallly/.well-known/openid-configuration
OIDC_CLIENT_ID=rallly
# Générer avec : openssl rand -hex 32
OIDC_CLIENT_SECRET=
# true : vote réservé aux utilisateurs connectés via OIDC
REQUIRE_OIDC_TO_VOTE=true
