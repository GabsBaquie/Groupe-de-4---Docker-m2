SECRET_PASSWORD=
POSTGRES_PASSWORD=
SUPPORT_EMAIL=support@example.com

# URL publique de Rallly (VM : http://<IP-VM>:3000). Sert au base URL de l'app
# et à la redirect URI OIDC du blueprint.
RALLLY_URL=http://localhost:3000

# Authentik (IdP OIDC)
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
# Le provider OIDC et l'application "rallly" sont créés au démarrage par le
# blueprint authentik/blueprints/rallly.yaml, avec ces identifiants.
# VM : http://<IP-VM>:9000/application/o/rallly/.well-known/openid-configuration
OIDC_DISCOVERY_URL=http://authentik.localhost:9000/application/o/rallly/.well-known/openid-configuration
OIDC_CLIENT_ID=rallly
# Générer avec : openssl rand -hex 32
OIDC_CLIENT_SECRET=
# true : vote réservé aux utilisateurs connectés via OIDC
REQUIRE_OIDC_TO_VOTE=true
